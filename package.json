{
  "name": "@fleet/agent-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-testing": "bin/agent-testing.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs adapters/vaultwealth/runtime/qualify-agent.test.mjs",
    "site:render": "node scripts/render-catalog.mjs",
    "validate:vaultwealth": "node bin/agent-testing.mjs validate --manifest adapters/vaultwealth/runtime/shared-benchmark.manifest.json",
    "syntax": "node scripts/check-syntax.mjs",
    "site:dev": "wrangler dev",
    "site:dry-run": "wrangler deploy --dry-run --outdir artifacts/wrangler-dry-run",
    "deploy": "wrangler deploy",
    "check": "npm run site:render && npm run syntax && npm test && npm run validate:vaultwealth && npm run site:dry-run && git diff --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.135.0"
  }
}
