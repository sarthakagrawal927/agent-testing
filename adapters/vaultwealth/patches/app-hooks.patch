@@ -0,0 +1,17 @@
+import { Linking } from 'react-native';
+
+export async function installExperimentReset() {
+  if (process.env.EXPO_PUBLIC_TESTING_EXPERIMENT !== 'true') return;
+  const { queryClient } = await import('../query-client');
+  const global = globalThis as typeof globalThis & { __vaultExperimentReset?: { remove(): void } };
+  global.__vaultExperimentReset?.remove();
+  global.__vaultExperimentReset = Linking.addEventListener('url', ({ url }) => {
+    const parsed = new URL(url);
+    const epoch = parsed.searchParams.get('__testingReset');
+    if (parsed.protocol !== 'vault-dev:' || !epoch || !/^\d+$/.test(epoch)) return;
+    // Reset cached fixture data only. Authentication and all tested form/search
+    // interactions still go through the ordinary app UI.
+    queryClient.clear();
+    void fetch(`http://127.0.0.1:18791/cache-reset/ack?epoch=${epoch}`, { method: 'POST' }).catch(() => {});
+  });
+}
