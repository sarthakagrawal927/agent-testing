+jest.mock('msw', () => ({
+  bypass: (request: Request) => request,
+  http: { all: jest.fn() },
+  HttpResponse: {},
+  passthrough: jest.fn(),
+}));
+
+import { experimentTransport, verifyExperimentTransport } from './experiment-transport';
+
+describe('isolated experiment transport handshake', () => {
+  const originalFetch = globalThis.fetch;
+  afterEach(() => {
+    globalThis.fetch = originalFetch;
+    delete process.env.EXPO_PUBLIC_TESTING_EXPERIMENT;
+    delete (globalThis as { __vaultExperimentReady?: boolean }).__vaultExperimentReady;
+  });
+
+  it('does nothing in ordinary mock builds', async () => {
+    globalThis.fetch = jest.fn();
+    expect(experimentTransport()).toBeNull();
+    await verifyExperimentTransport();
+    expect(globalThis.fetch).not.toHaveBeenCalled();
+  });
+
+  it('opens readiness only after the fixture echoes its challenge', async () => {
+    process.env.EXPO_PUBLIC_TESTING_EXPERIMENT = 'true';
+    globalThis.fetch = jest.fn(async (url) => ({
+      json: async () => ({ kind: 'vault-testing-fixture', nonce: new URL(String(url)).searchParams.get('nonce') }),
+    })) as unknown as typeof fetch;
+    await verifyExperimentTransport();
+    expect((globalThis as { __vaultExperimentReady?: boolean }).__vaultExperimentReady).toBe(true);
+    expect(String((globalThis.fetch as jest.Mock).mock.calls[0][0])).toMatch(/^http:\/\/vault-testing\.invalid\//);
+  });
+
+  it('rejects a response from anything other than the fixture', async () => {
+    process.env.EXPO_PUBLIC_TESTING_EXPERIMENT = 'true';
+    globalThis.fetch = jest.fn(async () => ({
+      json: async () => ({ kind: 'not-fixture', nonce: 'wrong' }),
+    })) as unknown as typeof fetch;
+    await expect(verifyExperimentTransport()).rejects.toThrow('Fixture handshake failed');
+    expect((globalThis as { __vaultExperimentReady?: boolean }).__vaultExperimentReady).not.toBe(true);
+  });
+
+  it('does not announce readiness after a network failure', async () => {
+    process.env.EXPO_PUBLIC_TESTING_EXPERIMENT = 'true';
+    globalThis.fetch = jest.fn(async () => {
+      throw new Error('offline');
+    });
+    await expect(verifyExperimentTransport()).rejects.toThrow('offline');
+    expect((globalThis as { __vaultExperimentReady?: boolean }).__vaultExperimentReady).not.toBe(true);
+  });
+});
diff --git a/src/mocks/experiment-transport.ts b/src/mocks/experiment-transport.ts
new file mode 100644
index 000000000..782d45e7f
--- /dev/null
+++ b/src/mocks/experiment-transport.ts
@@ -0,0 +1,46 @@
+import { bypass, http, HttpResponse, passthrough } from 'msw';
+
+// Opt-in loopback transport used only by the local driver experiment.
+export const experimentTransport = () => {
+  if (process.env.EXPO_PUBLIC_TESTING_EXPERIMENT !== 'true') return null;
+  return [
+    http.all('*', async ({ request }) => {
+      const url = new URL(request.url);
+      if (!url.pathname.startsWith('/api/') && ['127.0.0.1', 'localhost'].includes(url.hostname)) return passthrough();
+      if (!url.pathname.startsWith('/api/')) return HttpResponse.json({});
+      const response = await fetch(
+        bypass(
+          new Request(`http://127.0.0.1:18791${url.pathname}${url.search}`, {
+            method: request.method,
+            headers: { 'Content-Type': 'application/json', Authorization: request.headers.get('authorization') ?? '' },
+            ...(request.method !== 'GET' && request.method !== 'HEAD' ? { body: await request.text() } : {}),
+          }),
+        ),
+      );
+      return new HttpResponse(await response.text(), {
+        status: response.status,
+        headers: { 'Content-Type': response.headers.get('content-type') ?? 'application/json' },
+      });
+    }),
+  ];
+};
+
+export async function verifyExperimentTransport() {
+  if (process.env.EXPO_PUBLIC_TESTING_EXPERIMENT !== 'true') return;
+  const nonce = String(Math.random());
+  const controller = new AbortController();
+  // This non-React request owns its global timer and clears it in finally.
+  const timer = globalThis.setTimeout(() => controller.abort(), 5000);
+  try {
+    // .invalid can never be a production destination. Only the interceptor can
+    // route this challenge to the loopback fixture and return the matching nonce.
+    const response = await fetch(`http://vault-testing.invalid/api/experiment/ping?nonce=${nonce}`, {
+      signal: controller.signal,
+    });
+    const result = await response.json();
+    if (result.kind !== 'vault-testing-fixture' || result.nonce !== nonce) throw new Error('Fixture handshake failed');
+    Object.assign(globalThis, { __vaultExperimentReady: true });
+  } finally {
+    clearTimeout(timer);
+  }
+}
