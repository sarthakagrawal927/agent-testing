@@ -0,0 +1,73 @@
+let mockEnabled = false;
+let mockEffect: (() => void) | undefined;
+const mockSetReady = jest.fn();
+const mockStart = jest.fn();
+
+jest.mock('config', () => ({
+  get ENABLE_MOCKS() {
+    return mockEnabled;
+  },
+}));
+jest.mock('react', () => ({
+  useState: (initial: boolean) => [initial, mockSetReady],
+  useEffect: (effect: () => void) => {
+    mockEffect = effect;
+  },
+}));
+jest.mock('mocks/bootstrap', () => ({ enableMocking: () => mockStart() }));
+
+function initialGate(injectStartup = false) {
+  let gate!: (start?: () => Promise<void>) => boolean;
+  jest.isolateModules(() => {
+    gate = jest.requireActual('./use-mocks-ready').useMocksReady;
+  });
+  return gate(injectStartup ? mockStart : undefined);
+}
+
+describe('experiment mock readiness gate', () => {
+  beforeEach(() => {
+    jest.useFakeTimers();
+    mockSetReady.mockReset();
+    mockStart.mockReset().mockResolvedValue(undefined);
+    mockEffect = undefined;
+    mockEnabled = false;
+    delete process.env.EXPO_PUBLIC_TESTING_EXPERIMENT;
+    jest.spyOn(console, 'error').mockImplementation(() => {});
+  });
+  afterEach(() => {
+    jest.useRealTimers();
+    jest.restoreAllMocks();
+    delete process.env.EXPO_PUBLIC_TESTING_EXPERIMENT;
+  });
+
+  it('keeps normal non-mock builds open without starting mocks', () => {
+    expect(initialGate()).toBe(true);
+    mockEffect?.();
+    expect(mockStart).not.toHaveBeenCalled();
+  });
+  it('fails closed when experiment and mock flags disagree', async () => {
+    process.env.EXPO_PUBLIC_TESTING_EXPERIMENT = 'true';
+    expect(initialGate()).toBe(false);
+    mockEffect?.();
+    await jest.runAllTimersAsync();
+    expect(mockSetReady).not.toHaveBeenCalled();
+  });
+  it('fails closed on experiment interceptor startup rejection', async () => {
+    process.env.EXPO_PUBLIC_TESTING_EXPERIMENT = 'true';
+    mockEnabled = true;
+    mockStart.mockRejectedValue(new Error('interceptor failed'));
+    expect(initialGate(true)).toBe(false);
+    mockEffect?.();
+    await jest.runAllTimersAsync();
+    expect(mockSetReady).not.toHaveBeenCalled();
+  });
+  it('opens only after successful experiment startup', async () => {
+    process.env.EXPO_PUBLIC_TESTING_EXPERIMENT = 'true';
+    mockEnabled = true;
+    expect(initialGate(true)).toBe(false);
+    mockEffect?.();
+    await jest.runAllTimersAsync();
+    expect(console.error).not.toHaveBeenCalled();
+    expect(mockSetReady).toHaveBeenCalledWith(true);
+  });
+});
