+import { useEffect, useState } from 'react';
+
+// Deliberate, opt-in visual mutation on the isolated test build only.
+export function useExperimentVisualFault() {
+  const [clipped, setClipped] = useState(false);
+  useEffect(() => {
+    if (process.env.EXPO_PUBLIC_TESTING_EXPERIMENT !== 'true' || process.env.EXPO_PUBLIC_ENABLE_MOCKS !== 'true')
+      return;
+    let active = true;
+    void fetch('http://127.0.0.1:18791/health')
+      .then((response) => response.json())
+      .then((state) => {
+        if (active) setClipped(state.fault === 'clipped');
+      })
+      .catch(() => {
+        /* The mock readiness gate handles unavailable transport. */
+      });
+    return () => {
+      active = false;
+    };
+  }, []);
+  return clipped;
+}
